@model sem1.Models.Author

@{
    ViewData["Title"] = "Detalii Autor";
}

<h1>Detalii Autor: @Model.FullName</h1>

<div>
    <h4>Cărțile scrise</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Titlu</th>
                <th>Gen</th>
                <th>Preț</th>
                <th>Număr comenzi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Genre</td>
                    <td>@book.Price</td>
                    <td>@book.Orders?.Count()</td>
                </tr>
            }
        </tbody>
    </table>

    <p><strong>Număr total comenzi pentru autor: </strong> @Model.Books.Sum(b => b.Orders?.Count() ?? 0)</p>
</div>